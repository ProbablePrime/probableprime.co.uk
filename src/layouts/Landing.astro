---
/**
 * Layout for the hand-built pages (home, contact, success). These keep the
 * original probableprime.co.uk look. Blog pages use Base.astro instead.
 */
import "../styles/landing.css";

interface Props {
	title: string;
	description?: string;
	canonical?: string;
	/** Allow the page to scroll (the home page fits one screen; forms don't). */
	scroll?: boolean;
}

const { title, description, canonical, scroll = false } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<meta name="author" content="ProbablePrime" />
		{canonical && <link rel="canonical" href={canonical} />}
		<link rel="shortcut icon" href="/images/favicon.ico" />
		<link rel="alternate" type="application/rss+xml" title="ProbablePrime RSS Feed" href="/rss.xml" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/normalize.css@8.0.1/normalize.css" />
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/flexboxgrid/6.3.1/flexboxgrid.min.css"
		/>
		<slot name="head" />
	</head>
	<body class:list={{ scroll }}>
		<slot />
	</body>
</html>

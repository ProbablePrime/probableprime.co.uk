---
/**
 * About: the "about" entry from the pages collection, followed by the
 * companies collection. Both are edited in the admin (Pages > About and
 * Companies); each company links to its own page at /work/[slug]. The
 * "Find me elsewhere" links are the footer's socials (src/data/profile.ts).
 */
import { getEmDashCollection, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import CompanyLogo from "../components/CompanyLogo.astro";
import { personJsonLd, socials } from "../data/profile";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/prose.css";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "about");
const { entries: companies, cacheHint: companiesCacheHint } = await getEmDashCollection(
	"companies",
	{ orderBy: { sort_order: "asc" } },
);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(companiesCacheHint);
}

const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = page
	? getSeoMeta(page, { siteTitle, siteUrl: Astro.url.origin, path: "/about" })
	: null;
const title = page?.data.title ?? "About";
---

<Base
	title={seo?.title ?? title}
	pageTitle={seo?.ogTitle}
	description={seo?.description ?? "About ProbablePrime and the things I've worked on."}
	canonical={seo?.canonical}
	robots={seo?.robots}
	content={page ? { collection: "pages", id: page.data.id, slug: "about" } : undefined}
>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

	<article class="band page">
		<div class="frame page__layout">
			<header class="page__header">
				<img src="/images/logo.png" alt="" width="97" height="100" class="page__avatar" />
				<h1 class="page__title" {...page?.edit.title}>{title}</h1>
			</header>

			{
				page && (
					<div class="prose page__body" {...page.edit.content}>
						<PortableText value={page.data.content} />
					</div>
				)
			}
		</div>
	</article>

	{
		companies.length > 0 && (
			<section class="band section" aria-labelledby="startups-title">
				<div class="frame">
					<h2 id="startups-title" class="eyebrow startups__title">Where I've worked</h2>
					<ul class="startups">
						{companies.map((c) => (
							<li>
								<a class="startup" href={`/work/${c.id}`}>
									{c.data.logo && (
										<CompanyLogo
											class="startup__logo"
											image={c.data.logo}
											background={c.data.logo_background}
											sizes="16rem"
										/>
									)}
									<span class="startup__name">{c.data.title}</span>
									<span class="startup__years">
										{c.data.years} {c.data.current && <strong>Present</strong>}
									</span>
									{c.data.tech && <span class="startup__tech">{c.data.tech}</span>}
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	<section class="band section" aria-labelledby="elsewhere-title">
		<div class="frame">
			<h2 id="elsewhere-title" class="eyebrow startups__title">Find me elsewhere</h2>
			<ul class="elsewhere">
				{
					socials.map((s) => (
						<li>
							<a
								class="elsewhere__link"
								href={s.href}
								target="_blank"
								rel="noopener noreferrer me"
								style={`--social-color: ${s.color}`}
							>
								<span class="elsewhere__icon" aria-hidden="true">
									<span class={`fa-brands ${s.icon}`} />
								</span>
								<span class="elsewhere__label">{s.label}</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Base>

<style>
	.page {
		padding-block: clamp(3rem, 2rem + 4vw, 5.5rem);
	}

	.page__layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--spacing-8);
	}

	.page__avatar {
		width: 72px;
		height: auto;
		margin-bottom: var(--spacing-5);
	}

	.page__title {
		font-size: var(--font-size-display);
		line-height: 1.05;
	}

	@media (min-width: 960px) {
		.page__layout {
			grid-template-columns: minmax(14rem, 1fr) minmax(0, var(--content-width));
			column-gap: clamp(2rem, 1rem + 4vw, 6rem);
		}
	}

	.section {
		padding-block: var(--spacing-12) var(--spacing-16);
	}

	.startups__title {
		margin-bottom: var(--spacing-6);
	}

	.startups {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
		gap: var(--spacing-5);
		list-style: none;
	}

	.startup {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-1);
		height: 100%;
		padding: var(--card-padding);
		padding-bottom: var(--spacing-6);
		border-radius: var(--radius-xl);
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
		color: var(--color-text);
		text-align: center;
		text-decoration: none;
		transition: box-shadow var(--transition-fast), transform var(--transition-fast);
	}

	.startup:hover {
		box-shadow: var(--shadow-card-hover);
		transform: translateY(-2px);
	}

	/* Tile colour comes from CompanyLogo; this only sizes it. */
	.startup :global(.startup__logo) {
		align-self: stretch;
		height: 140px;
		margin-bottom: var(--spacing-4);
		padding: var(--spacing-5);
	}

	.startup__name {
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-heading);
	}

	.startup__years {
		color: var(--color-text-secondary);
	}

	.startup__years strong {
		color: var(--color-brand);
	}

	.startup__tech {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.elsewhere {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(12rem, 100%), 1fr));
		gap: var(--spacing-4);
		list-style: none;
	}

	.elsewhere__link {
		display: flex;
		align-items: center;
		gap: var(--spacing-4);
		height: 100%;
		padding: var(--spacing-3);
		padding-inline-end: var(--spacing-5);
		border-radius: var(--radius-xl);
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
		color: var(--color-text);
		font-weight: var(--font-weight-heading);
		text-decoration: none;
		transition: box-shadow var(--transition-fast), transform var(--transition-fast);
	}

	.elsewhere__link:hover {
		box-shadow: var(--shadow-card-hover);
		transform: translateY(-2px);
	}

	.elsewhere__icon {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 3rem;
		height: 3rem;
		border-radius: 50%;
		background: var(--social-color);
		color: #fff;
		font-size: 1.375rem;
		/* Keep near-black brands (GitHub, X) visible on the dark canvas */
		box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
	}
</style>

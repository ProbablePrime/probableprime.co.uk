---
import Base from "../layouts/Base.astro";
---

<Base title="Message sent" robots="noindex">
	<header class="band intro">
		<div class="frame">
			<p class="eyebrow">Contact</p>
			<h1 class="intro__title">Got your message!</h1>
			<p class="intro__subtitle">Thanks for reaching out. I'll get back to you as soon as possible.</p>
			<p class="actions">
				<a href="/" class="btn">Back to the homepage</a>
			</p>
		</div>
	</header>
</Base>

<style>
	.actions {
		margin-top: var(--spacing-8);
	}
</style>

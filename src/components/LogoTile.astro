---
/**
 * A company or project logo on a neutral tile. Old logos mix dark and
 * light artwork and have no dark-mode variants, so each entry picks a light
 * or dark tile in the admin ("Logo background") and the tile keeps that
 * colour in both colour modes. Size the tile from the parent via `class`.
 */
import { Image } from "emdash/ui";

interface Props {
	image: Parameters<typeof Image>[0]["image"];
	background?: string | null;
	sizes: string;
	priority?: boolean;
	class?: string;
}

const { image, background, sizes, priority, class: className } = Astro.props;
const tone = background === "dark" ? "dark" : "light";
---

<span class:list={["logo-tile", `logo-tile--${tone}`, className]}>
	<Image image={image} alt="" placeholder={false} sizes={sizes} priority={priority} />
</span>

<style>
	/* The parent sets the tile's width/height. A single minmax(0, 1fr) cell
	   gives the image a definite box, and object-fit scales any logo shape
	   (wide wordmark or square mark) to fit inside it. */
	.logo-tile {
		display: grid;
		grid-template: minmax(0, 1fr) / minmax(0, 1fr);
		padding: var(--spacing-4);
		border-radius: var(--radius-lg);
	}

	.logo-tile :global(img) {
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: contain;
	}

	.logo-tile--light {
		background: var(--logo-tile-light);
		box-shadow: inset 0 0 0 1px var(--color-border);
	}

	.logo-tile--dark {
		background: var(--logo-tile-dark);
	}
</style>

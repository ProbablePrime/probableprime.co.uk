---
import { kofi, socials } from "../data/profile";
---

<div class="socials">
	<ul class="socials__icons">
		{
			socials.map((s) => (
				<li>
					<a
						href={s.href}
						target="_blank"
						rel="noopener noreferrer me"
						aria-label={s.label}
						title={s.label}
						style={`--social-color: ${s.color}`}
					>
						<span class={`fa-brands ${s.icon}`} aria-hidden="true" />
					</a>
				</li>
			))
		}
	</ul>
	<a class="socials__kofi" href={kofi} target="_blank" rel="noopener noreferrer">
		<img src="/images/kofi.png" alt="Buy me a coffee on Ko-fi" width="180" height="35" loading="lazy" />
	</a>
</div>

<style>
	.socials {
		display: grid;
		gap: var(--spacing-5);
		justify-items: start;
		margin-top: var(--spacing-6);
	}

	.socials__icons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		list-style: none;
	}

	.socials__icons a {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 50%;
		background: var(--social-color);
		color: #fff;
		font-size: 1rem;
		text-decoration: none;
		/* Keep near-black brands (GitHub, X) visible on the dark canvas */
		box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
		transition: transform var(--transition-fast);
	}

	.socials__icons a:hover {
		transform: translateY(-2px);
	}

	.socials__kofi img {
		width: 180px;
		height: auto;
	}
</style>

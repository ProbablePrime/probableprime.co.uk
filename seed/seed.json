					"title": "Hello, blog",
					"excerpt": "I finally have somewhere to write things down.",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "For years this site has been a single page of links. I kept meaning to start a blog and never had the time to set one up.",
									"_key": "k10"
								}
							],
							"_key": "k11"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Now there is one. It runs on EmDash, an Astro based CMS, on Cloudflare Workers, which is where the site already lived.",
									"_key": "k12"
								}
							],
							"_key": "k13"
						},
						{
							"_type": "block",
							"style": "normal",

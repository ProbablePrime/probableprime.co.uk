{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "probableprime-co-uk",
  "main": "src/index.js",
  "compatibility_date": "2024-08-19",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/contact"]
  },
  "routes": [
    { "pattern": "probableprime.co.uk", "custom_domain": true },
    { "pattern": "www.probableprime.co.uk", "custom_domain": true }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
